# --- Opción A: Ollama local (gratis, sin reloj de créditos) ---
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
MODEL=llama3.1

# --- Opción B: Gemini free tier (gratis, sin hardware local) ---
# Sacá la API key en https://aistudio.google.com/apikey
# Confirmá el nombre exacto del modelo free en AI Studio.
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=tu_api_key_de_google_ai_studio
# MODEL=gemini-2.5-flash

# --- Opción C: Azure AI Foundry (Fase 1+, usa créditos, autenticación keyless) ---
# Requiere haber corrido `az login` antes (provider.py pide un token con DefaultAzureCredential).
# PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.services.ai.azure.com/openai/v1/
# MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small

# --- PROVIDER: elige qué implementación de get_client() usa provider.py ---
# (lo leen rag.py, ingest.py y agent.py; chat.py de Fase 0 no lo usa, siempre lee
# OPENAI_BASE_URL/OPENAI_API_KEY de arriba)
# PROVIDER=ollama   # default si no se setea: usa OPENAI_BASE_URL/OPENAI_API_KEY (Opción A o B)
# PROVIDER=azure    # usa Azure AI Foundry keyless, ver Opción C arriba

# --- Azure AI Search (Fase 1B, requerido por rag.py / ingest.py / create_index.py) ---
# AZURE_SEARCH_ENDPOINT=https://<tu-servicio>.search.windows.net
# AZURE_SEARCH_INDEX=bc-docs
# AZURE_SEARCH_KEY=tu_admin_key   # si no la seteás, usa DefaultAzureCredential (keyless)

# --- Azure AI Document Intelligence (Fase 2, requerido por doc_intel.py) ---
# AZURE_DOCINTEL_ENDPOINT=https://<tu-recurso>.cognitiveservices.azure.com/
# AZURE_DOCINTEL_KEY=tu_key   # si no la seteás, usa DefaultAzureCredential (keyless)

# --- Microsoft Agent Framework (Fase 2b, requerido por agent_af.py; usa `az login`) ---
# PROJECT_ENDPOINT=https://<tu-recurso>.services.ai.azure.com/api/projects/<tu-proyecto>
# MODEL_DEPLOYMENT_NAME=gpt-5-mini
