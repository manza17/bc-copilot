# --- Opción A: Ollama local (gratis, sin reloj de créditos) ---
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
MODEL=llama3.1

# --- Opción B: Gemini free tier (gratis, sin hardware local) ---
# Sacá la API key en https://aistudio.google.com/apikey
# Confirmá el nombre exacto del modelo free en AI Studio.
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=tu_api_key_de_google_ai_studio
# MODEL=gemini-2.5-flash

# --- Opción C: Azure AI Foundry (Fase 1, usa créditos) ---
# La configuramos juntos cuando pasemos a la nube.
# OPENAI_API_KEY=tu_api_key_de_azure
# OPENAI_BASE_URL=https://<tu-recurso>.openai.azure.com/openai/v1/
# MODEL=gpt-4o-mini
